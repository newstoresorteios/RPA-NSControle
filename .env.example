# Neon Postgres (same DB as NSControle). Prefer UNPOOLED for DDL/migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Portal Importador RPA (NOT the CWS Rastro API credentials)
CORREIOS_USER=
CORREIOS_PASSWORD=

# Correios API Rastro (status sync) — prefer these; run via NSControle:
#   node --env-file=.env.local scripts/correios-status-sync.mjs
# Credentials live in NSControle .env.local (never commit):
# CORREIOS_API_URL=https://api.correios.com.br
# CORREIOS_API_USER=
# CORREIOS_API_TOKEN=
# CORREIOS_API_CARTAO=
# CORREIOS_API_CONTRATO=
# CORREIOS_API_DR=
# CORREIOS_API_MOCK=1

# Optional runtime knobs
# HEADED=0
# HOURLY_LIMIT=12
# SMOKE_MEDIA_DIR=
# PRINT_TIMEOUT_MS=15000
# ENTREGUES_DELAY_MS=2500
# ENTREGUES_MAX_ROUNDS=50
# ENTREGUES_ROUND_PAUSE_MS=60000
